<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 
    HƯỚNG DẪN:
    1. Copy các file .ttf hoặc .otf của font Mona Sans vào thư mục res/font này.
    2. Đổi tên file thành chữ thường và gạch dưới. Ví dụ:
       - mona_sans_regular.ttf -> mona_sans_regular.ttf
       - mona_sans_bold.ttf    -> mona_sans_bold.ttf
    3. Bỏ comment (xóa <!- - và - ->) ở các dòng dưới đây để kích hoạt font.
    -->

    <!-- Font thường (Regular - 400) -->
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/mona_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400"
        app:font="@font/mona_sans_regular" />

    <!-- Font đậm (Bold - 700) -->
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/mona_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700"
        app:font="@font/mona_sans_bold" />
    
    <!-- Font vừa (Medium - 500) -->
    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/mona_sans_medium"
        app:fontStyle="normal"
        app:fontWeight="500"
        app:font="@font/mona_sans_medium" />
    
    <!-- Font SemiBold (600) -->
    <font
        android:fontStyle="normal"
        android:fontWeight="600"
        android:font="@font/mona_sans_semibold"
        app:fontStyle="normal"
        app:fontWeight="600"
        app:font="@font/mona_sans_semibold" />

</font-family>