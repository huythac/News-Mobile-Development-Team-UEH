<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Handle (Top) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@color/handle_bar" />

    <!-- Header: X button + Title -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="22dp"
        android:gravity="center_vertical">

        <!-- Close Button (X) -->
        <ImageView
            android:id="@+id/btnCloseLanguage"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:contentDescription="@string/close"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="?attr/colorOnSurface" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvLanguageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/language"
            android:textAppearance="@style/TextAppearance.Setting.SectionTitle"
            android:layout_centerInParent="true"
            android:textColor="?attr/colorOnSurface" />

    </RelativeLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="8dp" />

    <!-- Language Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingBottom="16dp">

        <!-- Vietnamese Option -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/optionVietnamese"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvVietnamesePrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_vietnamese_primary"
                android:textAppearance="@style/TextAppearance.Setting.ItemTitle"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvVietnameseSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_vietnamese_secondary"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvVietnamesePrimary" />

            <ImageView
                android:id="@+id/radioVietnamese"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_radio_checked"
                android:visibility="visible"
                app:tint="#84CC16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="8dp" />

        <!-- English Option -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/optionEnglish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvEnglishPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_english_primary"
                android:textAppearance="@style/TextAppearance.Setting.ItemTitle"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvEnglishSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_english_secondary"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvEnglishPrimary" />

            <ImageView
                android:id="@+id/radioEnglish"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_radio_checked"
                android:visibility="gone"
                app:tint="#84CC16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- Save Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="8dp"
        android:paddingBottom="32dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveLanguage"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:enabled="false"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/btn_save_language_selector"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>

