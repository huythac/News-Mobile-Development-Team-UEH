<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Handle (Top) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@color/handle_bar" />

    <!-- Header: X button + Title -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="22dp"
        android:gravity="center_vertical">

        <!-- Close Button (X) -->
        <ImageView
            android:id="@+id/btnCloseTheme"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/close"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:tint="?attr/colorOnSurface"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/theme"
            android:textAppearance="@style/TextAppearance.Setting.ScreenTitle"
            android:layout_centerInParent="true"
            android:textColor="?attr/colorOnSurface" />
    </RelativeLayout>

    <!-- Theme Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingBottom="16dp">

        <!-- Light Theme Option -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/optionLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvLightTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_light_display"
                android:textAppearance="@style/TextAppearance.Setting.ItemTitle"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/radioLight"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_radio_checked"
                android:visibility="visible"
                app:tint="#84CC16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="8dp" />

        <!-- Dark Theme Option -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/optionDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvDarkTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_dark_display"
                android:textAppearance="@style/TextAppearance.Setting.ItemTitle"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/radioDark"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_radio_checked"
                android:visibility="gone"
                app:tint="#84CC16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- Save Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="8dp"
        android:paddingBottom="32dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveTheme"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:enabled="false"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/btn_save_language_selector"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>

