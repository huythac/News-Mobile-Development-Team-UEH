<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingTop="16dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="0dp">

    <!-- Author Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <!-- Avatar -->
        <androidx.cardview.widget.CardView
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/article_background">

            <ImageView
                android:id="@+id/imgAvatarSmall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_avatar_circle"
                tools:src="@mipmap/ic_launcher_round" />

        </androidx.cardview.widget.CardView>

        <!-- Author Name -->
        <TextView
            android:id="@+id/tvAuthorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="@style/TextAppearance.Article.Meta"
            android:textSize="14sp"
            android:textColor="@color/article_text_secondary"
            android:fontFamily="@font/mona_sans"
            tools:text="Người viết bài" />

    </LinearLayout>

    <!-- Content Row: Text + Thumbnail -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:baselineAligned="false">

        <!-- Text Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Article.Title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/article_text_primary"
                android:maxLines="3"
                android:ellipsize="end"
                android:fontFamily="@font/mona_sans"
                android:lineSpacingExtra="2dp"
                tools:text="Tiêu đề" />

            <!-- Description -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.Article.Description"
                android:textColor="@color/article_text_secondary"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:fontFamily="@font/mona_sans"
                android:lineSpacingExtra="2dp"
                tools:text="Mô tả..." />

        </LinearLayout>

        <!-- Thumbnail Image -->
        <androidx.cardview.widget.CardView
            android:layout_width="100dp"
            android:layout_height="70dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <ImageView
                android:id="@+id/imgArticleThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_avatar_circle"
                tools:src="@mipmap/ic_launcher_round" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Meta Row: Date + Comment Count + Bookmark -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingEnd="4dp"
        android:paddingBottom="20dp">

        <!-- Left: Date + Comment Count -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@id/imgBookmark"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Date -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mona_sans"
                android:textAppearance="@style/TextAppearance.Article.Meta"
                android:textColor="@color/article_text_secondary"
                android:textSize="12sp"
                tools:text="28/11/2025" />

            <!-- Comment Count (with icon) -->
            <LinearLayout
                android:id="@+id/layoutCommentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/imgComment"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Bình luận"
                    android:src="@drawable/chat_circle"
                    app:tint="@color/article_text_secondary" />

                <TextView
                    android:id="@+id/tvCommentCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mona_sans"
                    android:textAppearance="@style/TextAppearance.Article.Meta"
                    android:textColor="@color/article_text_secondary"
                    android:textSize="12sp"
                    tools:text="" />

            </LinearLayout>

        </LinearLayout>

        <!-- Right: Bookmark Icon -->
        <ImageView
            android:id="@+id/imgBookmark"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="0dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Lưu"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/bookmark_simple"
            app:tint="@color/bookmark_default"
            tools:src="@drawable/bookmarks"
            tools:tint="@color/bookmark_saved" />

        <!-- Delete Icon (only for history tab, hidden by default) -->
        <ImageView
            android:id="@+id/imgDelete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Xóa"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_trash"
            android:visibility="gone"
            app:tint="@color/article_text_secondary" />

    </RelativeLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/article_divider" />

</LinearLayout>
