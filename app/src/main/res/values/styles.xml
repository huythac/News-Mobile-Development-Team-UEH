<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    

    <style name="SocialButtonStyle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">30dp</item>
        <item name="strokeColor">#E0E0E0</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">16dp</item>
        <item name="iconTint">@null</item>
        <item name="backgroundTint">@android:color/white</item>
    </style>
    
    <!-- Search Tag Style (existing) -->
    <style name="SearchTagStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip_block</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>
    
    <!-- Article Detail TextAppearance Styles -->
    
    <!-- Title TextAppearance -->
    <style name="TextAppearance.Article.Title" parent="TextAppearance.AppCompat.Headline">
        <item name="android:fontFamily">@font/mona_sans</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/article_text_primary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
    </style>
    
    <!-- Meta TextAppearance (Author, Date) -->
    <style name="TextAppearance.Article.Meta" parent="TextAppearance.AppCompat.Body2">
        <item name="android:fontFamily">@font/mona_sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/article_text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    
    <!-- Description TextAppearance -->
    <style name="TextAppearance.Article.Description" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">@font/mona_sans</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/article_text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    
    <!-- Content TextAppearance -->
    <style name="TextAppearance.Article.Body" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">@font/mona_sans</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/article_text_primary</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:lineSpacingExtra">@dimen/article_detail_content_line_spacing</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    
    <!-- Category Chip Style -->
    <style name="CategoryChipStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/article_chip_text</item>
        <item name="android:fontFamily">@font/mona_sans</item>
        <item name="chipBackgroundColor">@color/article_chip_background</item>
        <item name="chipMinHeight">28dp</item>
        <item name="chipCornerRadius">@dimen/article_detail_category_radius</item>
        <item name="android:paddingStart">@dimen/article_detail_category_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/article_detail_category_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/article_detail_category_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/article_detail_category_padding_vertical</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <!-- Bottom Sheet Dialog Theme -->
    <style name="BottomSheetDialogTheme" parent="Theme.MaterialComponents.Light">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>
    
    <style name="BottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/BottomSheetShapeAppearance</item>
        <item name="backgroundTint">@color/article_background</item>
    </style>
    
    <style name="BottomSheetShapeAppearance" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/comments_sheet_corner_radius</item>
        <item name="cornerSizeTopRight">@dimen/comments_sheet_corner_radius</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    
</resources>
